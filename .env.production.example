# Template environment untuk deploy Docker di VPS.
#
#   cp .env.production.example .env.production
#   nano .env.production
#   docker compose --env-file .env.production up -d --build
#
# ------------------------------------------------------------------------------
# PENTING: file ini BUKAN pasangan dari `.env`.
#
#   .env             → dev di laptop, dibaca python-dotenv di dalam app, prefiks MYSQL_*
#   .env.production  → deploy, dibaca docker-compose untuk substitusi ${...}, prefiks DB_*
#
# Namanya sengaja dibedakan. docker-compose otomatis membaca `.env` kalau ada,
# jadi kalau template ini dinamai `.env` juga, menjalankan compose di laptop akan
# diam-diam memungut SECRET_KEY dev-mu.
#
# Prefiksnya juga sengaja DB_ dan bukan MYSQL_: `.env` lokal berisi MYSQL_USER=root,
# dan nilai itu kalau sampai masuk ke MARIADB_USER akan membuat container DB mati
# (root sudah ada, CREATE USER 'root' gagal, exit 1).
# ------------------------------------------------------------------------------

# Kunci session Flask. WAJIB diisi.
# App punya fallback 'default-secret-key', tapi fallback itu HANYA berlaku kalau
# variabelnya tidak ada sama sekali — kalau diisi kosong, Flask dapat string kosong
# dan login admin mati. Jadi isi beneran.
#   openssl rand -hex 32
SECRET_KEY=

# Kredensial MariaDB. Password root dan password user aplikasi harus berbeda.
# DB_USER jangan diisi 'root' — entrypoint MariaDB akan menolak dan container exit 1.
#   openssl rand -base64 24
DB_ROOT_PASSWORD=
DB_USER=alumni
DB_PASSWORD=
DB_NAME=alumni_db

# Batas ukuran upload dalam byte (default 5MB). Kalau dinaikkan, naikkan juga
# `request_body max_size` di Caddyfile supaya Caddy tidak memutus duluan.
MAX_CONTENT_LENGTH=5242880
